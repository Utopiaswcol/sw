# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: URL for Supabase PostgreSQL + pgvector instance
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Service role key for backend elevated operations
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE_ANON_KEY: Anonymous public key for Supabase client
SUPABASE_ANON_KEY=""

# WOMPI_PUBLIC_KEY: Key for Wompi Colombia checkout widget (Descriptor SERVICIOS DIGITALES S.A.S.)
WOMPI_PUBLIC_KEY=""

# WOMPI_EVENTS_SECRET: Secret key for verifying Wompi webhook signature
WOMPI_EVENTS_SECRET=""
